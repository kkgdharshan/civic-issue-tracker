# CivicPulse Production Environment Configuration

# ==============================================================================
# 1. DATABASE & POSTGIS CONFIGURATION
# ==============================================================================
# Primary connection pool (for transactional writes and outbox)
DATABASE_URL="postgresql://civic_admin:civic_secure_password_2026@localhost:5432/civicpulse?schema=public&connection_limit=50&pool_timeout=10"

# Direct URL for Prisma migrations (bypasses connection poolers like PgBouncer)
DIRECT_URL="postgresql://civic_admin:civic_secure_password_2026@localhost:5432/civicpulse?schema=public"

# ==============================================================================
# 2. REDIS CLUSTER CONFIGURATION (Cache, Rate Limiting, Write-Behind Buffer)
# ==============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="civicpulse:"

# ==============================================================================
# 3. AWS S3 ASSET STORAGE (Direct Presigned Uploads)
# ==============================================================================
AWS_REGION="us-west-2"
AWS_ACCESS_KEY_ID="AKIA_SAMPLE_KEY_EXAMPLE"
AWS_SECRET_ACCESS_KEY="SAMPLE_SECRET_ACCESS_KEY_EXAMPLE"
AWS_S3_BUCKET_NAME="civicpulse-incident-assets-prod"
AWS_CLOUDFRONT_DOMAIN="cdn.civicpulse.internal"

# ==============================================================================
# 4. WEBSOCKET & REAL-TIME EVENT STREAM
# ==============================================================================
NEXT_PUBLIC_WS_URL="wss://realtime.civicpulse.internal"

# ==============================================================================
# 5. GOOGLE GEMINI AI MULTIMODAL INFERENCE
# ==============================================================================
GEMINI_API_KEY="AIzaSy_SAMPLE_GEMINI_KEY_EXAMPLE"
GEMINI_MODEL="gemini-1.5-flash"

# ==============================================================================
# 6. OBSERVABILITY & TELEMETRY
# ==============================================================================
LOG_LEVEL="info"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
